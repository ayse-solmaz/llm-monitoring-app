# Backend API prefix (include /api/v1)
# NOTE: when Docker MLC nginx is on host :8080, run the Go API on another port
# (e.g. PORT=8081) or point this at Render production.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Server-side MLC KPI gateway (FastAPI → nginx → mlc replicas)
NEXT_PUBLIC_MLC_URL=http://localhost:8080

# Production (Vercel): set in Project → Settings → Environment Variables
# NEXT_PUBLIC_API_URL=https://llm-monitoring-api.onrender.com/api/v1
# NEXT_PUBLIC_MLC_URL=http://localhost:8080   # only for local Docker MLC demos
