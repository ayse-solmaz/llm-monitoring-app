# Backend API prefix (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Browser talks to same-origin /api/mlc (Next proxy). Upstream for the proxy:
MLC_UPSTREAM=http://127.0.0.1:8080

NEXT_PUBLIC_MLC_MODEL_ID=/app/model
NEXT_PUBLIC_MAX_TOKENS=256

# Production (Vercel):
# NEXT_PUBLIC_API_URL=https://llm-monitoring-api.onrender.com/api/v1
# MLC_UPSTREAM=https://YOUR-TUNNEL.trycloudflare.com
# NEXT_PUBLIC_MLC_MODEL_ID=/app/model
# NEXT_PUBLIC_MAX_TOKENS=256
# (Do NOT rely on NEXT_PUBLIC_MLC_URL in the browser anymore.)
